import "./ArtifactEnums.tsp";

using TypeSpec.Http;
using TypeSpec.Rest;
using TypeSpec.Versioning;
using Azure.Core;
using Azure.ResourceManager;

namespace Microsoft.Migrate;

@added(ApiVersions.v2026_06_15_preview)
@doc("A Migrate artifact. Artifacts are read-only Azure Resource Manager projections of documents generated for a Migrate project.")
@parentResource(MigrateProject)
model Artifact is ProxyResource<ArtifactProperties> {
  @doc("The name of the artifact.")
  @key("artifactName")
  @segment("artifacts")
  @path
  @minLength(1)
  @maxLength(90)
  @pattern("^[A-Za-z0-9][A-Za-z0-9_.-]{0,89}$")
  name: string;
}

#suppress "@azure-tools/typespec-azure-resource-manager/arm-resource-provisioning-state" "Artifact is a read-only Azure Resource Manager projection of a document generated by the Migrate service. It exposes no create, update, or delete operations and has no independent provisioning lifecycle, so provisioningState is intentionally omitted."
@added(ApiVersions.v2026_06_15_preview)
@doc("The properties of a Migrate artifact.")
model ArtifactProperties {
  @doc("The type of the artifact.")
  @visibility(Lifecycle.Read)
  artifactType?: ArtifactType;

  @doc("The Azure Resource Manager ID of the resource that this artifact is associated with, if any.")
  @visibility(Lifecycle.Read)
  associatedResourceId?: armResourceIdentifier;

  @doc("The identifier of the latest version of the artifact. VersionIds are unordered and supplied by the client during creation")
  @visibility(Lifecycle.Read)
  latestVersionId?: string;

  @doc("The latest version number of the artifact. Version numbers are monotonically increasing integers assigned at commit time, starting at 1.")
  @visibility(Lifecycle.Read)
  latestVersion?: int32;

  @doc("The hash of the `metadata.json` present in the latest version of the artifact, formatted as `{algorithm}:<hex>`. Clients may verify integrity of the artifact by checking this hash against the downloaded `metadata.json`.")
  @visibility(Lifecycle.Read)
  latestVersionMetadataHash?: string;
}

@added(ApiVersions.v2026_06_15_preview)
@doc("Optional OData filter for listing Migrate artifacts by their parent Migrate project.")
model ArtifactListQueryParams {
  @doc("An OData `$filter` expression to constrain the returned artifacts. Supported filters are `associatedResourceId eq '<armResourceId>'` and `artifactType eq '<ArtifactType>'`, which may be combined with `and`.")
  @query("$filter")
  filter?: string;
}

@added(ApiVersions.v2026_06_15_preview)
@doc("A single version entry in the version history of a Migrate artifact.")
model VersionHistoryEntry {
  @doc("The identifier of this version, supplied by the client at creation time.")
  versionId: string;

  @doc("The version number, assigned at commit time, starting at 1, indicating the ordering in versions.")
  version: int32;

  @doc("The hash of the `metadata.json` present in this version, formatted as `{algorithm}:<hex>`.")
  metadataHash: string;

  @doc("The timestamp, in UTC, at which this version was committed.")
  committedAt: utcDateTime;
}

@added(ApiVersions.v2026_06_15_preview)
@doc("The version history of a Migrate artifact.")
model ArtifactVersionHistoryResult {
  @doc("The name of the artifact.")
  artifactName: string;

  @doc("The type of the artifact.")
  artifactType: ArtifactType;

  @doc("The identifier of the latest version of the artifact. VersionIds are unordered and supplied by the client during creation")
  latestVersionId: string;

  @doc("The latest version number of the artifact. Version numbers are monotonically increasing integers assigned at commit time, starting at 1.")
  latestVersion: int32;

  @doc("The ordered list of version history entries for the artifact, most recent first. The service retains only the 20 most recent versions, so this list contains at most 20 entries.")
  @identifiers(#["versionId"])
  @maxItems(20)
  history: VersionHistoryEntry[];
}

@added(ApiVersions.v2026_06_15_preview)
@doc("The request to generate a download URL for a Migrate artifact. Clients need not specify both of `versionId` and `version`. If both are specified, they must agree with each other. If neither is specified, the latest version is used.")
model GenerateDownloadUrlRequest {
  @doc("The identifier of the artifact version to download. When omitted, the latest version of the artifact is used. If both `versionId` and `version` are specified, they must agree with each other.")
  versionId?: string;

  @doc("The version number to download. When omitted, the latest artifact version is used. If both `versionId` and `version` are specified, they must agree with each other.")
  version?: int32;

  @doc("Whether to download a single file or a directory within the artifact.")
  mode: DownloadMode;

  @doc("The path, relative to the artifact root, of the file or directory to download.")
  path: string;

  @doc("Whether to include metadata alongside the downloaded content.")
  includeMetadata?: boolean;
}

@added(ApiVersions.v2026_06_15_preview)
@doc("The result of generating a download URL for a Migrate artifact.")
model GenerateDownloadUrlResult {
  @doc("The name of the artifact.")
  artifactName: string;

  @doc("The identifier of the artifact version that the download URL refers to.")
  versionId: string;

  @doc("The version number of the artifact version present at the download URL.")
  version: int32;

  @doc("Whether the download URL refers to a single file or a directory within the artifact.")
  mode: DownloadMode;

  @doc("The path, relative to the artifact root, that the download URL refers to.")
  path: string;

  @doc("The shared access signature (SAS) URL that can be used to download the requested content.")
  @secret
  @visibility(Lifecycle.Read)
  sasUrl: string;

  @doc("The timestamp, in UTC, at which the download URL expires.")
  expiresAt: utcDateTime;
}

@added(ApiVersions.v2026_06_15_preview)
@doc("The status values for an asynchronous generateDownloadUrl operation on a Migrate artifact.")
@Azure.Core.lroStatus
union GenerateDownloadUrlOperationState {
  string,

  @doc("The download archive is still being generated. Poll again after the interval indicated by the Retry-After header.")
  InProgress: "InProgress",

  @doc("The operation completed successfully. The generated download URL is available in the result properties.")
  Succeeded: "Succeeded",

  @doc("The operation failed. See the error details for more information.")
  Failed: "Failed",

  @doc("The operation was canceled.")
  Canceled: "Canceled",
}

@added(ApiVersions.v2026_06_15_preview)
@doc("The status of an asynchronous generateDownloadUrl operation on a Migrate artifact. When the operation succeeds, the generated download URL is available in the `properties` field.")
model GenerateDownloadUrlOperationStatus is ArmOperationStatus<
  GenerateDownloadUrlResult,
  GenerateDownloadUrlOperationState
>;
