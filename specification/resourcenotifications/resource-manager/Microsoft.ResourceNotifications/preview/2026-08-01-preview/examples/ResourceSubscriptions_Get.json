{
  "operationId": "ResourceSubscriptions_Get",
  "title": "Get a resource subscription with cloud scope and partitioning",
  "parameters": {
    "subscriptionId": "12345678-1234-1234-1234-123456789012",
    "resourceGroupName": "example-rg",
    "subscriptionRuleName": "inventory-subscription",
    "api-version": "2026-08-01-preview"
  },
  "responses": {
    "200": {
      "body": {
        "id": "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/example-rg/providers/Microsoft.ResourceNotifications/resourceSubscriptions/inventory-subscription",
        "name": "inventory-subscription",
        "type": "Microsoft.ResourceNotifications/resourceSubscriptions",
        "location": "westus",
        "properties": {
          "query": "where (event.type startswith 'Microsoft.ContainerService/managedClusters/nodes')",
          "scope": {
            "kind": "cloud",
            "providerNamespace": "Microsoft.ResourceGraph",
            "appId": "87654321-4321-4321-4321-210987654321",
            "id": "/subscriptions/12345678-1234-1234-1234-123456789012/resourceGroups/example-rg/providers/Microsoft.ResourceNotifications/namespaces/Microsoft.Compute"
          },
          "dataBoundary": "Global",
          "subscriberAuthType": "DSTS",
          "deliveryModeConfiguration": {
            "kind": "Partitioning",
            "configurationSettings": {
              "kind": "arnLocation",
              "partitions": [
                {
                  "name": "p0",
                  "regions": [
                    "centraluseuap",
                    "eastus2euap"
                  ]
                },
                {
                  "name": "p1",
                  "regions": [
                    "northeurope",
                    "westeurope"
                  ]
                }
              ]
            }
          },
          "provisioningState": "Succeeded"
        }
      }
    }
  }
}
