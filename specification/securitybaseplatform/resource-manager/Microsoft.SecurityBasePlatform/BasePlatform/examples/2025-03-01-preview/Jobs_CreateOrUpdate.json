            "enabled": true,
            "secretName": "pfx-geneva-prd",
            "appProcessName": "Backfill.Job.dll",
            "openTelemetry": {
              "enabled": true,
              "otlpPort": 4317
            }
          },
          "logTail": {
            "enabled": true,
            "sources": [
              {
                "fileName": "/var/log/job.log",
                "containerName": "backfill",
                "excludeLogTailer": false
              }
            ]
          },
          "routing": {
            "logRoutes": [
              {
                "name": "geneva",
                "destination": "genevaMdsd"
              }
            ],
            "metricRoutes": [
              {
                "name": "mdm",
                "destination": "genevaMdm"
              }
            ]
          },
          "operatorManaged": {
            "enabled": true,
            "manageCertificates": true
