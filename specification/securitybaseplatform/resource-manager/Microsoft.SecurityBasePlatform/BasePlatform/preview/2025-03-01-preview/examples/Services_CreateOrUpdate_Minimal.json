{
  "operationId": "Services_CreateOrUpdate",
  "title": "Create a minimal private service with a fixed replica count",
  "parameters": {
    "api-version": "2025-03-01-preview",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "rg-secbaseplatform",
    "clusterName": "prod-cluster",
    "namespaceName": "threat-intel",
    "serviceName": "enricher",
    "resource": {
      "location": "eastus2",
      "properties": {
        "image": {
          "registry": "secbaseplatform.azurecr.io",
          "repository": "threat-intel/enricher",
          "tag": "2.0.0"
        },
        "scalingProfile": {
          "mode": "Fixed",
          "fixed": {
            "replicas": 2
          }
        },
        "ports": [
          {
            "containerPort": 9090
          }
        ],
        "placement": {
          "tolerations": [
            {
              "key": "gpu",
              "operator": "Equal",
              "value": "true",
              "effect": "NoSchedule"
            }
          ]
        },
        "ingress": {
          "enabled": false
        }
      }
    }
  },
  "responses": {
    "200": {
      "body": {
        "id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-secbaseplatform/providers/Microsoft.SecurityBasePlatform/clusters/prod-cluster/namespaces/threat-intel/services/enricher",
        "name": "enricher",
        "type": "Microsoft.SecurityBasePlatform/clusters/namespaces/services",
        "location": "eastus2",
        "properties": {
          "image": {
            "registry": "secbaseplatform.azurecr.io",
            "repository": "threat-intel/enricher",
            "tag": "2.0.0"
          },
          "scalingProfile": {
            "mode": "Fixed",
            "fixed": {
              "replicas": 2
            }
          },
          "provisioningState": "Succeeded",
          "ingress": {
            "enabled": false
          }
        }
      }
    },
    "201": {
      "body": {
        "id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-secbaseplatform/providers/Microsoft.SecurityBasePlatform/clusters/prod-cluster/namespaces/threat-intel/services/enricher",
        "name": "enricher",
        "type": "Microsoft.SecurityBasePlatform/clusters/namespaces/services",
        "location": "eastus2",
        "properties": {
          "image": {
            "registry": "secbaseplatform.azurecr.io",
            "repository": "threat-intel/enricher",
            "tag": "2.0.0"
          },
          "provisioningState": "Accepted"
        }
      }
    }
  }
}
