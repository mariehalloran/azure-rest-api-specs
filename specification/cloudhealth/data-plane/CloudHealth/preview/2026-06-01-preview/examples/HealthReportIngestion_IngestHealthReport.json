{
  "operationId": "HealthReportIngestion_IngestHealthReport",
  "title": "Ingest an entity health report",
  "parameters": {
    "endpoint": "https://contoso-1f33ba.eastus.data.cloudhealth.azure.com",
    "api-version": "2026-06-01-preview",
    "entityName": "frontend-web-app",
    "body": {
      "signalName": "request-latency-p95",
      "healthState": "Degraded",
      "value": 240,
      "evaluationRules": {
        "degradedRule": {
          "operator": "GreaterThan",
          "threshold": 200
        },
        "unhealthyRule": {
          "operator": "GreaterThanOrEqual",
          "threshold": 500
        }
      },
      "expiresInMinutes": 60,
      "additionalContext": "p95 latency exceeded the degraded threshold."
    }
  },
  "responses": {
    "202": {}
  }
}
