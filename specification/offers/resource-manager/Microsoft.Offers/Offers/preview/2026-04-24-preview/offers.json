  "definitions": {
    "Availability": {
      "type": "object",
      "description": "Availability information for a value exchange.",
      "properties": {
        "availabilityId": {
          "type": "string",
          "description": "The stable availability identifier (typically equal to the value-exchange id)."
        },
        "markets": {
          "type": "array",
          "description": "Markets in which this availability is offered (ISO 3166 country codes).",
          "items": {
            "type": "string"
          }
        },
        "consumptionUnitType": {
          "type": "string",
          "description": "Consumption unit type (for example, \"DAY\")."
        },
        "displayRank": {
          "type": "integer",
          "format": "int32",
          "description": "Display rank for ordering."
        },
        "alternateIds": {
          "type": "array",
          "description": "Alternate identifiers.",
          "items": {
            "type": "string"
          }
        },
        "lastModifiedDate": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified date for the availability record."
        },
        "conditions": {
          "$ref": "#/definitions/AvailabilityConditions",
          "description": "Conditions under which the availability applies."
        },
        "terms": {
          "type": "array",
          "description": "Purchase terms offered by this availability.",
          "items": {
            "$ref": "#/definitions/AvailabilityTerm"
          },
          "x-ms-identifiers": [
            "termId"
          ]
        },
        "supportedLanguages": {
          "type": "array",
          "description": "Synthesized intersection of the SKU's market properties and the availability's markets.",
          "items": {
            "type": "string"
          }
        },
        "meters": {
          "type": "array",
          "description": "Synthesized subset of the SKU's meter data filtered by the availability's meter type.",
          "items": {
            "$ref": "#/definitions/AvailabilityMeter"
          },
          "x-ms-identifiers": []
        },
        "properties": {
          "$ref": "#/definitions/PcdPropertyBag",
          "description": "Curated availability property subset projected from the upstream catalog."
        }
      },
      "required": [
        "availabilityId"
      ]
    },
    "AvailabilityConditions": {
      "type": "object",
      "description": "Conditions under which the availability applies.",
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Start date of the availability window."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "End date of the availability window. The upstream `9999-...` sentinel is scrubbed to null."
        },
        "isPermanent": {
          "type": "boolean",
          "description": "Whether the availability is permanent."
        },
        "supportedCatalogVersion": {
          "type": "integer",
          "format": "int32",
          "description": "Supported catalog version."
        },
        "resourceSetIds": {
          "type": "array",
          "description": "Resource set identifiers.",
          "items": {
            "type": "string"
          }
        },
        "eligibilityPredicateIds": {
          "type": "array",
          "description": "Eligibility predicate identifiers.",
          "items": {
            "type": "string"
          }
        },
        "clientConditions": {
          "$ref": "#/definitions/ClientConditions",
          "description": "Client-side conditions."
        }
      }
    },
    "AvailabilityMeter": {
      "type": "object",
      "description": "A meter bound to this value exchange (synthesized from the upstream meter data, filtered by meter type).",
      "additionalProperties": {}
    },
    "AvailabilityTerm": {
      "type": "object",
      "description": "A purchase term offered by an availability.",
      "properties": {
        "termId": {
          "type": "string",
          "description": "The stable term identifier."
        },
        "termUnits": {
          "type": "string",
          "description": "ISO-8601 duration for the term (for example, \"P1Y\")."
        },
        "termDescription": {
          "type": "string",
          "description": "Human-readable term description."
        }
      }
    },
    "ClientConditions": {
      "type": "object",
      "description": "Client-side conditions for an availability.",
      "properties": {
        "allowedPlatforms": {
          "type": "array",
          "description": "Allowed client platforms; empty list means no platform restriction.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LookupEnumerationRequest": {
      "type": "object",
      "description": "Request body for looking up an enumeration set by its type key.",
      "properties": {
        "enumerationType": {
          "type": "string",
          "description": "The enumeration type key (for example, `categories`, `productFamilies`, `claimTypes`).",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        }
      },
      "required": [
        "enumerationType"
      ]
    },
    "LookupEnumerationResult": {
      "type": "object",
      "description": "The result of an enumeration lookup.",
      "properties": {
        "enumerationType": {
          "type": "string",
          "description": "The enumeration type key the result corresponds to."
        },
        "values": {
          "type": "array",
          "description": "The enumeration values. Values are passed through verbatim from the upstream catalog feed.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enumerationType"
      ]
    },
    "LookupValueExchangeRequest": {
      "type": "object",
      "description": "Request body for looking up a value exchange (UPN) by its identifier.",
      "properties": {
        "valueExchangeId": {
          "type": "string",
          "description": "The value-exchange identifier (BigCat UPN id, e.g. `DZH318Z0995B`).",
          "pattern": "^[A-Z0-9]{12}$"
        }
      },
      "required": [
        "valueExchangeId"
      ]
    },
    "LookupValueExchangeResult": {
      "type": "object",
      "description": "The result of a value-exchange lookup.",
      "properties": {
        "valueExchangeId": {
          "type": "string",
          "description": "The value-exchange identifier the result corresponds to."
        },
        "properties": {
          "$ref": "#/definitions/ValueExchangeProperties",
          "description": "The denormalized, slim value-exchange projection."
        }
      },
      "required": [
        "valueExchangeId",
        "properties"
      ]
    },
    "PcdPropertyBag": {
      "type": "object",
      "description": "A curated property bag projected from the upstream catalog. Unbounded key set.",
      "additionalProperties": {}
    },
    "Product": {
      "type": "object",
      "description": "Denormalized product summary for a value exchange.",
      "properties": {
        "productId": {
          "type": "string",
          "description": "The stable product identifier."
        },
        "productFamily": {
          "type": "string",
          "description": "Product family (for example, \"Azure\")."
        },
        "productType": {
          "type": "string",
          "description": "Product type (for example, \"Azure\")."
        },
        "productKind": {
          "type": "string",
          "description": "Product kind (for example, \"Azure\")."
        },
        "lastModifiedDate": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified date for the product record."
        },
        "publisherName": {
          "type": "string",
          "description": "Lifted single-language publisher name from the upstream catalog feed."
        },
        "properties": {
          "$ref": "#/definitions/PcdPropertyBag",
          "description": "Curated product property subset projected from the upstream catalog."
        }
      },
      "required": [
        "productId"
      ]
    },
    "Sku": {
      "type": "object",
      "description": "Denormalized SKU summary for a value exchange.",
      "properties": {
        "skuId": {
          "type": "string",
          "description": "The stable SKU identifier."
        },
        "skuType": {
          "type": "string",
          "description": "SKU type (for example, \"enterpriseonline\")."
        },
        "productId": {
          "type": "string",
          "description": "The product identifier this SKU belongs to."
        },
        "lastModifiedDate": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified date for the SKU record."
        },
        "properties": {
          "$ref": "#/definitions/PcdPropertyBag",
          "description": "Curated SKU property subset projected from the upstream catalog. Includes partner channel and deactivated lifecycle state."
        }
      },
      "required": [
        "skuId"
      ]
    },
    "ValueExchangeProperties": {
      "type": "object",
      "description": "Properties of a value exchange (UPN). Wraps the denormalized trio of\nProduct, Sku, and Availability. Slim shape: large blobs (raw meter data,\norder management data, passthrough sub-objects, co-sell, attributes) are\ndropped here and live on the rich hydrate response.",
      "properties": {
        "product": {
          "$ref": "#/definitions/Product",
          "description": "Denormalized product summary."
        },
        "sku": {
          "$ref": "#/definitions/Sku",
          "description": "Denormalized SKU summary."
        },
        "availability": {
          "$ref": "#/definitions/Availability",
          "description": "Availability information for this value exchange."
        }
      },
      "required": [
        "product",
        "sku",
        "availability"
      ]
    }
  },
  "parameters": {}
}
